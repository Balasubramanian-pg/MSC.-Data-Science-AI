        "\n",
        "# Mark the peak (MLE)\n",
        "mle_mu_resid = np.mean(residuals)\n",
        "mle_sig_resid = np.std(residuals)\n",
        "peak_ll = -gaussian_nll([0.0, mle_mu_resid, mle_sig_resid], np.zeros_like(residuals), residuals)\n",
