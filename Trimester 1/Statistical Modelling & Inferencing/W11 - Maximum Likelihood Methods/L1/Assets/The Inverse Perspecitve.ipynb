        "# Create a grid of Mu and Sigma values\n",
        "mu_grid = np.linspace(-2.0, 2.0, 40)\n",
        "sigma_grid = np.linspace(0.5, 4.0, 40)\n",
        "MU, SIGMA = np.meshgrid(mu_grid, sigma_grid)\n",
        "Z = np.zeros_like(MU)\n",
        "\n",
        "for i in range(MU.shape[0]):\n",
        "    for j in range(MU.shape[1]):\n",
        "        # Computing Log-Likelihood (negative of NLL)\n",
        "        Z[i, j] = -gaussian_nll([0.0, MU[i, j], SIGMA[i, j]], np.zeros_like(residuals), residuals)\n",
